{
  "Comment": "AI Influencer Video Generation Pipeline",
  "StartAt": "AI_Prep",
  "States": {
    "AI_Prep": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:315974965935:function:okvevo-ai-prep",
        "Payload": {
          "jobId.$": "$.jobId",
          "userId.$": "$.userId",
          "topic.$": "$.topic",
          "duration.$": "$.duration",
          "avatarVideoUrl.$": "$.avatarVideoUrl",
          "fal_mode.$": "$.fal_mode",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$.aiPrepResult",
      "TimeoutSeconds": 31622400,
      "Next": "Wait_For_Avatar",
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "Next": "Handle_Failure"
        }
      ]
    },
    "Wait_For_Avatar": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:315974965935:function:okvevo-noop",
        "Payload": {
          "jobId.$": "$.jobId",
          "userId.$": "$.userId",
          "fal_mode.$": "$.fal_mode",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$.waitResult",
      "TimeoutSeconds": 3600,
      "Next": "Submit_LipSync"
    },
    "Submit_LipSync": {
      "Type": "Task",
      "Resource": "arn:aws:states:::lambda:invoke.waitForTaskToken",
      "Parameters": {
        "FunctionName": "arn:aws:lambda:us-east-1:315974965935:function:okvevo-lipsync-submit",
        "Payload": {
          "jobId.$": "$.jobId",
          "userId.$": "$.userId",
          "fal_mode.$": "$.fal_mode",
          "ttsUrl.$": "$.aiPrepResult.audioUrl",
          "avatarVideoUrl.$": "$.waitResult.avatarVideoUrl",
          "taskToken.$": "$$.Task.Token"
        }
      },
      "ResultPath": "$.lipSyncResult",
      "TimeoutSeconds": 3600,
      "Next": "Render_Video",
      "Catch": [
        {
          "ErrorEquals": ["States.Timeout"],
          "Next": "Handle_Failure"
        }
      ]
    },
    "Render_Video": {
      "Type": "Task",
      "Resource": "arn:aws:lambda:us-east-1:315974965935:function:okvevo-renderer",
      "Parameters": {
        "jobId.$": "$.jobId",
        "userId.$": "$.userId",
        "lipSyncVideoUrl.$": "$.lipSyncResult.lipSyncVideoUrl",
        "audioUrl.$": "$.aiPrepResult.audioUrl",
        "imageTimeline.$": "$.aiPrepResult.images"
      },
      "Next": "Complete",
      "Retry": [
        {
          "ErrorEquals": ["Lambda.ServiceException", "Lambda.AWSLambdaException", "Lambda.SdkClientException"],
          "IntervalSeconds": 5,
          "MaxAttempts": 2,
          "BackoffRate": 2.0
        }
      ]
    },
    "Handle_Failure": {
      "Type": "Fail",
      "Error": "JobFailed",
      "Cause": "The AI Influencer pipeline failed or timed out."
    },
    "Complete": {
      "Type": "Succeed"
    }
  }
}
