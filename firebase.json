{
  "apphosting": {
    "backendId": "okvevo-web",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      ".firebase",
      ".next",
      ".venv",
      "graphify-out",
      ".env",
      ".env.local",
      ".env.dev",
      ".env.*.local",
      "public/Nia",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "logs"
    ]
  },
  "storage": {
    "rules": "storage.rules"
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  }
}
