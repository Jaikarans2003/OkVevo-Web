rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ponytail: okvevo-testing previously relied on open console rules.
    // Deploying a sparse sessions/users-only file locked every other collection.
    // This restores app functionality; tighten (Admin SDK for APIs, owner checks, admin claims)
    // before production.

    // —— Public / unauth client paths ——
    match /blogs/{blogId} {
      allow read: if true;
      allow create, delete: if request.auth != null;
      allow update: if request.auth != null
        || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views']);
    }

    match /contactSubmissions/{category}/submissions/{id} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    match /masiv_products/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /masiv_banners/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /trend_requests/{id} {
      allow read, create: if true;
      allow update, delete: if request.auth != null;
    }

    // Next API routes still use the client SDK with no Auth context
    match /coupons/{id} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    match /couponUsage/{id} {
      allow read, write: if true;
    }
    match /userPurchaseHistory/{id} {
      allow read, write: if true;
    }
    match /razorpaySubscriptions/{id} {
      allow read, write: if true;
    }
    match /affiliates/{id} {
      allow read, write: if true;
    }
    match /masivOrders/{id} {
      allow read, write: if true;
    }
    match /masiv_orders/{id} {
      allow read, write: if true;
    }

    // —— Owner-scoped (preferred) ——
    match /sessions/{sessionId} {
      // resource == null: client onSnapshot attaches before Admin create returns
      allow read: if request.auth != null && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
      }
      match /runs/{runId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
        match /events/{eventId} {
          allow read: if request.auth != null
            && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
        }
      }
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Orgs + remaining signed-in collections (admin UI, pro org sessions, audit logs, …)
    match /organisations/{id} {
      allow read, write: if request.auth != null;
    }
    match /proOrganisations/{id} {
      allow read, write: if request.auth != null;
      match /{document=**} {
        allow read, write: if request.auth != null;
      }
    }
    match /adminCreditAdjustments/{id} {
      allow read, write: if request.auth != null;
    }
    match /adminAuditLogs/{id} {
      allow read, write: if request.auth != null;
    }
    match /userStats/{id} {
      allow read, write: if request.auth != null;
    }
  }
}
