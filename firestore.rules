rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Unauth create only (contact form). No client read of submissions.
    match /contactSubmissions/{category}/submissions/{id} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    match /sessions/{sessionId} {
      // resource == null: client onSnapshot attaches before Admin create returns
      allow read: if signedIn() && (
        resource == null || resource.data.userId == request.auth.uid
      );
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid;

      match /messages/{messageId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
      }
      match /runs/{runId} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
        match /events/{eventId} {
          allow read: if signedIn()
            && get(/databases/$(database)/documents/sessions/$(sessionId)).data.userId == request.auth.uid;
        }
      }
    }

    match /users/{userId} {
      allow read: if isUser(userId);
      allow create: if isUser(userId)
        && request.resource.data.allocationBalance == 0
        && request.resource.data.topUpBalance == 0
        && request.resource.data.creditsIncluded == 0
        && request.resource.data.plan == null
        && request.resource.data.planStatus == null
        && (!('topUpPurchasedTotal' in request.resource.data)
            || request.resource.data.topUpPurchasedTotal == 0)
        && (!('allocationGrantedTotal' in request.resource.data)
            || request.resource.data.allocationGrantedTotal == 0)
        && !('razorpayCustomerId' in request.resource.data)
        && !('razorpaySubscriptionId' in request.resource.data)
        && !('nextAllocationDate' in request.resource.data)
        && !('currentPeriodEnd' in request.resource.data)
        && !('cancelAtPeriodEnd' in request.resource.data)
        && !('currency' in request.resource.data)
        && !('paymentMethod' in request.resource.data)
        && !('hasScheduledChanges' in request.resource.data)
        && !('scheduledPlanType' in request.resource.data)
        && !('scheduledPlanId' in request.resource.data)
        && !('scheduledChangeAt' in request.resource.data);
      allow update: if isUser(userId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'creditBalance',
          'allocationBalance',
          'topUpBalance',
          'topUpPurchasedTotal',
          'allocationGrantedTotal',
          'creditsIncluded',
          'plan',
          'planName',
          'planStatus',
          'billingCycle',
          'currency',
          'razorpayCustomerId',
          'razorpaySubscriptionId',
          'nextAllocationDate',
          'currentPeriodEnd',
          'cancelAtPeriodEnd',
          'paymentMethod',
          'hasScheduledChanges',
          'scheduledPlanType',
          'scheduledPlanId',
          'scheduledChangeAt'
        ]);

      match /subscriptions/{id} {
        allow read: if isUser(userId);
        allow write: if false;
      }
      match /creditTransactions/{id} {
        allow read: if isUser(userId);
        allow write: if false;
      }
    }

    match /creditTransactions/{id} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow write: if false;
    }

    match /desktopAuthCodes/{id} {
      allow read, write: if false;
    }

    match /gatewayJobs/{id} {
      allow read, write: if false;
    }

    match /razorpaySubscriptions/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if false;
    }

    match /opsAlerts/{id} {
      allow read, write: if false;
    }
  }
}
