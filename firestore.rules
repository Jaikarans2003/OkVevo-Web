rules_version = '2';

// Deny-all lock-down after the Supabase cutover.
// Deleting this file does not change live rules — they stay whatever was last
// deployed. Keep this file in firebase.json and deploy at the PR 1 gate:
//   staging:  firebase deploy --only firestore:rules --project okvevo-testing
//   production (on promotion): --project text2video-16cbf
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
