# Coupon & Affiliate System - Required Environment Variables

# ============================================
# ADMIN ACCESS
# ============================================
# Comma-separated list of admin emails who can manage affiliates and coupons
ADMIN_EMAILS=admin@okvevo.com,manager@okvevo.com

# ============================================
# EXISTING VARIABLES (Required)
# ============================================
# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project.firebaseio.com

# Firebase Admin SDK (Base64 encoded service account JSON)
FIREBASE_SERVICE_ACCOUNT_KEY=your_base64_encoded_service_account_key

# Razorpay Configuration
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ============================================
# NOTES
# ============================================
# 1. ADMIN_EMAILS: Users with these emails can:
#    - Create and manage affiliates
#    - Generate coupon codes
#    - View affiliate stats
#    - Access /admin/affiliates page
#
# 2. Affiliate Dashboard Access:
#    - Affiliates can access /affiliate-dashboard
#    - Must log in with email registered in affiliates collection
#    - No special env variable needed
#
# 3. Coupon System:
#    - Flat coupon code: OKVEVO100 (generated via admin panel)
#    - Affiliate codes: Auto-generated (format: AFF-{NAME}{RANDOM})
#    - Minimum order value: ₹199 (hardcoded, can be changed in API)
#
# 4. Commission Rate:
#    - Affiliate commission: 10% (hardcoded in affiliate creation API)
#    - Can be customized per affiliate in future updates
