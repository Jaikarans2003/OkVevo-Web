{
  "name": "okvevo-infrastructure",
  "version": "1.0.0",
  "description": "AWS CDK infrastructure for the OkVevo agent render completion flow",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "cdk": "cdk",
    "deploy:dev": "AWS_PROFILE=dev cdk deploy --all --context env=dev --require-approval never",
    "destroy:dev": "AWS_PROFILE=dev cdk destroy --all --context env=dev",
    "synth:dev": "AWS_PROFILE=dev cdk synth --context env=dev",
    "bootstrap:dev": "AWS_PROFILE=dev cdk bootstrap aws://052120999576/us-east-1",
    "diff:dev": "AWS_PROFILE=dev cdk diff --context env=dev"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "aws-cdk": "^2.114.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "aws-cdk-lib": "^2.114.0",
    "constructs": "^10.3.0"
  }
}
