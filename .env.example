# ============================================================
# OKVEVO — local / testing environment template
# Copy to .env and fill values. Never commit real secrets.
# Dev Firebase project comment: okvevo-testing (values stay empty here)
# ============================================================

# local | staging | production — prefer this over NODE_ENV for env.ts
OKVEVO_ENV=local

# CORS allowlist for /api/agent (comma-separated). Local defaults applied if unset while OKVEVO_ENV=local.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public site URL (SEO / metadataBase). Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Agent service (Next.js proxy). Local default: http://localhost:3001
AGENT_URL=http://localhost:3001

# Google Gemini
GEMINI_API_KEY=
NEXT_PUBLIC_GEMINI_API_KEY=
NEXT_PUBLIC_GROQ_API_KEY=

# AI Studio Backend API
NEXT_PUBLIC_AI_STUDIO_API_URL=

# Base URL — update with ngrok URL for local webhook testing
NEXT_PUBLIC_BASE_URL=

# Fal AI (shared keys — isolated by job IDs)
FAL_API_IMAGE=
FAL_API_VIDEO=
FAL_API_AUDIO=
FAL_API_KEY=
FAL_MODE=live

# AWS — Dev Account (IAM User: CDKDeploy-dev)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
S3_BUCKET_NAME=
SQS_QUEUE_NAME=
SFN_AI_INFLUENCER_ARN=
# Switch AI Studio chat to Bedrock AgentCore (set local to use Docker agent again)
AGENT_BACKEND=
AGENTCORE_RUNTIME_ARN=

# Firebase — inject per environment (no testing bucket fallback in code)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin SDK
FB_SERVICE_ACCOUNT_KEY=
FB_STORAGE_BUCKET=

# Razorpay — Test Keys (switch to live when ready)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Bypass subscription for testing
# NEXT_PUBLIC_BYPASS_SUBSCRIPTION=true

RAZORPAY_HOBBY_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_HOBBY_ANNUAL_PLAN_ID=
RAZORPAY_PRO_ANNUAL_PLAN_ID=
RAZORPAY_AFFILIATE_OFFER_ID=
RAZORPAY_WEBHOOK_SECRET=

ADMIN_EMAILS=

PEXELS_API_KEY=
OPENROUTER_API_KEY=
HEYGEN_API_KEY=
# Shared HMAC secret for the HeyGen signed callback token (must match services/agent/.env)
HEYGEN_CALLBACK_SECRET=
HEYGEN_CALLBACK_URL=
# Public HTTPS URL → Next /api/webhooks/fal (agent signs with HEYGEN_CALLBACK_SECRET)
FAL_CALLBACK_URL=

# Marketing videos (no Storage URLs in source — inject per env)
NEXT_PUBLIC_MARKETING_VIDEO_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Temporary Hosting SSE bypass (Cloud Run). Empty = same-origin /api/agent.
# Testing/prod values injected at deploy — never commit a concrete *.run.app URL.
NEXT_PUBLIC_AGENT_API_ORIGIN=

# AI Studio: show full raw agent trace (tool names, JSON). true on local/staging; unset in production.
# NEXT_PUBLIC_AGENT_DEV_TRACE=true
