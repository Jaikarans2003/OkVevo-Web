# ============================================================
# OKVEVO — local environment template
# Copy to .env and fill values. Never commit real secrets.
# Dev Firebase project comment: okvevo-testing (values stay empty here)
# Deployed values live in apphosting.yaml + Secret Manager, not this file.
# ============================================================

# local | staging | production — missing-var strictness only (not which Firebase project)
OKVEVO_ENV=local

# CORS allowlist (comma-separated). Local defaults applied if unset while OKVEVO_ENV=local.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public site URL (SEO / metadataBase / OpenRouter HTTP-Referer). Local default: http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Legacy agent proxy. Local default: http://localhost:3001
AGENT_URL=http://localhost:3001

# Optional same-origin override for old /api/agent SSE. Empty = same origin.
NEXT_PUBLIC_AGENT_API_ORIGIN=

# AWS region (required outside local if those leftover routes are hit)
AWS_REGION=
AWS_DEFAULT_REGION=

# Abandoned AgentCore — leave empty; do not build Cloud Nia on this
AGENT_BACKEND=
AGENTCORE_RUNTIME_ARN=

# Firebase — inject per environment (no testing bucket fallback in code)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Firebase Admin SDK (base64 JSON). FIREBASE_SERVICE_ACCOUNT_KEY is the App Hosting name;
# FB_SERVICE_ACCOUNT_KEY is the local alias.
FIREBASE_SERVICE_ACCOUNT_KEY=
FB_SERVICE_ACCOUNT_KEY=
FB_STORAGE_BUCKET=

# Razorpay — Test Keys (switch to live when ready)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Bypass subscription for testing — unset in any shared deploy
# NEXT_PUBLIC_BYPASS_SUBSCRIPTION=true

RAZORPAY_STARTER_PLAN_ID=
RAZORPAY_STARTER_ANNUAL_PLAN_ID=
RAZORPAY_HOBBY_PLAN_ID=
RAZORPAY_HOBBY_ANNUAL_PLAN_ID=
RAZORPAY_PRO_PLAN_ID=
RAZORPAY_PRO_ANNUAL_PLAN_ID=
RAZORPAY_AFFILIATE_OFFER_ID=
RAZORPAY_WEBHOOK_SECRET=

ADMIN_EMAILS=

OPENROUTER_API_KEY=

# Server-held Fal key for the OkVevo image/video gateway (FAL_KEY, local alias FAL_API_KEY)
FAL_KEY=
FAL_API_KEY=

# Server-held Tavily key for the OkVevo search gateway
TAVILY_API_KEY=
# Optional override; default 0.008 PAYG
TAVILY_USD_PER_CREDIT=

# Marketing videos (no Storage URLs in source — inject per env)
NEXT_PUBLIC_MARKETING_VIDEO_URL=
NEXT_PUBLIC_DEMO_VIDEO_URL=

# Legacy HeyGen HMAC (only if that route is still used)
HEYGEN_CALLBACK_SECRET=

# Legacy agent bundle (fail-loud outside local if still required)
HYPERFRAMES_BUCKET=

# AI Studio: show full raw agent trace. true on local; unset in shared deploys.
NEXT_PUBLIC_AGENT_DEV_TRACE=true
