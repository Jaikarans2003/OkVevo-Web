PORT=3040
LOG_LEVEL=info

# ElevenLabs Scribe — required for POST /transcribe and POST /process
ELEVENLABS_API_KEY=

# Upstream helpers (Refference/video-use locally; /opt/video-use in Docker)
VIDEO_USE_REPO=../../Refference/video-use

# Ephemeral job dirs (created on start)
VIDEO_USE_WORK_ROOT=./temp/work
VIDEO_USE_TEMP_ROOT=./temp

# No SRT burn-in on POST /process (transcripts still produced)
DISABLE_SUBTITLES=true
