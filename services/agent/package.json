{
  "name": "okvevo-agent",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "echo 'Agent is Docker-only. Run: docker compose up agent --build' >&2 && exit 1",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node22 --outfile=dist/server.js --external:firebase-admin --external:express --external:cors --external:groq-sdk --external:node-fetch --external:@hyperframes/aws-lambda/* --external:@aws-sdk/client-s3",
    "start": "echo 'Agent is Docker-only. Run: docker compose up agent --build' >&2 && exit 1",
    "typecheck": "tsc --noEmit",
    "check-planning": "npx tsx scripts/check-planning.ts",
    "check-templates": "node scripts/check-templates.mjs",
    "check-tool-registry": "npx tsx scripts/check-tool-registry.ts",
    "check-heygen-webhook": "npx tsx scripts/check-heygen-webhook.ts",
    "check-webhook-delivery": "npx tsx scripts/check-webhook-delivery.ts",
    "check-transcript-timeout": "npx tsx scripts/check-transcript-timeout.ts",
    "check-speaker-normalize": "npx tsx scripts/check-speaker-normalize.ts",
    "check-session-artifacts": "npx tsx scripts/check-session-artifacts.ts",
    "check-session-skills": "npx tsx checks/check-session-skills.ts",
    "check-session-token-gate": "npx tsx scripts/check-session-token-gate.ts",
    "check-shell-env": "npx tsx scripts/check-shell-env.ts",
    "check-render-idempotency": "npx tsx scripts/check-render-idempotency.ts",
    "check-skill-checkpoints": "npx tsx scripts/check-soft-ask.ts",
    "check-soft-ask": "npx tsx scripts/check-soft-ask.ts",
    "check-groq-connectivity": "bash scripts/check-groq-connectivity.sh",
    "deploy:agentcore": "bash scripts/deploy-agentcore.sh && bash scripts/verify-agentcore-deploy.sh"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1088.0",
    "@hyperframes/aws-lambda": "0.7.59",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "ai": "^7.0.79",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "esbuild": "^0.28.1",
    "express": "^4.18.0",
    "firebase-admin": "^14.3.0",
    "groq-sdk": "^0.7.0",
    "node-fetch": "^3.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
