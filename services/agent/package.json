{
  "name": "okvevo-agent",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "dev": "echo 'Agent is Docker-only. Run: docker compose up agent --build' >&2 && exit 1",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node20 --outfile=dist/server.js --external:firebase-admin --external:express --external:cors --external:groq-sdk --external:node-fetch",
    "start": "echo 'Agent is Docker-only. Run: docker compose up agent --build' >&2 && exit 1",
    "typecheck": "tsc --noEmit",
    "check-planning": "TS_NODE_TRANSPILE_ONLY=true ts-node scripts/check-planning.ts",
    "check-templates": "node scripts/check-templates.mjs",
    "check-tool-registry": "TS_NODE_TRANSPILE_ONLY=true ts-node scripts/check-tool-registry.ts"
  },
  "dependencies": {
    "@openrouter/ai-sdk-provider": "^2.0.0",
    "ai": "^6.0.206",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "firebase-admin": "^12.0.0",
    "groq-sdk": "^0.7.0",
    "node-fetch": "^3.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "ts-node": "^10.9.0",
    "typescript": "^5.0.0"
  }
}
