# OkVevo Agent — copy to .env and fill in your credentials.
# Never commit .env (secrets). This file is safe to commit.

OPENROUTER_API_KEY=
PORT=3001

# Firebase Admin
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_SERVICE_ACCOUNT_KEY=
FB_SERVICE_ACCOUNT_KEY=
FIREBASE_STORAGE_BUCKET=
FB_STORAGE_BUCKET=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Transcription / tool models
GROQ_API_KEY=
AGENT_TOOL_MODEL=anthropic/claude-sonnet-4-5

# Renderer services (local defaults)
MANIM_RENDERER_URL=http://localhost:3031
HYPERFRAMES_RENDERER_URL=http://localhost:3030

# Optional overrides
EDU_VIDEO_TEMPLATE_DIR=
HYPERFRAMES_CLI=
