{
  "family": "okvevo-hyperframes-renderer",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::ACCOUNT_ID:role/okvevoHyperframesTaskRole",
  "containerDefinitions": [
    {
      "name": "hyperframes",
      "image": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/okvevo/hyperframes:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 3030,
          "protocol": "tcp"
        }
      ],
      "environment": [],
      "mountPoints": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/okvevo-hyperframes-renderer",
          "awslogs-region": "REGION",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
