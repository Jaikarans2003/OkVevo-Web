# Prevent host architecture-specific artifacts from contaminating container builds
# This file is used when building from the service directory context

# Node.js dependencies (may contain native binaries for host platform)
node_modules
node_modules/**

# Bun artifacts (platform-specific binaries and caches)
.bun
.bun/**

# Build output directories (may contain platform-specific binaries)
dist
dist/**

# Cache directories
.cache
.turbo
.next

# Development artifacts
npm-debug.log
yarn-debug.log
yarn-error.log
pnpm-debug.log
lerna-debug.log
*.log

# Git
.git
.gitignore
.gitattributes

# Environment and secrets
.env
.env.*
!.env.example

# Temporary build artifacts
tmp/rendering/**
!tmp/rendering/.gitkeep
tmp/**
temp/**

# Output files (rendered videos)
output/*.mp4
output/*.webm
output/*.mov
!output/.gitkeep

# macOS artifacts
.DS_Store
.AppleDouble
.LSOverride
._*

# IDE and editor artifacts
.vscode
.idea
.cursor
*.swp
*.swo
*~
.editorconfig

# Test and coverage
coverage
.nyc_output
*.test.js.snap

# Documentation build artifacts
docs/.vuepress/dist
docs/.cache
