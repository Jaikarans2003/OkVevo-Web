# Docker build context = N8N workspace root (contains OKVEVO/ and references/).
# Goal: never send host macOS/Windows native artifacts (esbuild, .node, Bun caches) into Linux builds.

# --- references/hyperframes (HyperFrames monorepo) ---
references/hyperframes/node_modules
references/hyperframes/node_modules/**
references/hyperframes/.bun
references/hyperframes/.bun/**
references/hyperframes/packages/*/node_modules
references/hyperframes/packages/*/node_modules/**
references/hyperframes/packages/*/.bun
references/hyperframes/packages/*/dist
references/hyperframes/packages/*/dist/**
references/hyperframes/packages/*/.turbo
references/hyperframes/dist
references/hyperframes/.turbo
references/hyperframes/.cache

# --- OKVEVO (apps + services) ---
OKVEVO/node_modules
OKVEVO/node_modules/**
OKVEVO/**/node_modules
OKVEVO/**/node_modules/**
OKVEVO/**/.bun
OKVEVO/**/.bun/**
OKVEVO/**/dist
OKVEVO/**/dist/**
OKVEVO/**/.turbo
OKVEVO/**/.cache
OKVEVO/**/.next
OKVEVO/**/.nuxt
OKVEVO/**/.parcel-cache
OKVEVO/**/.vite

# npm / pnpm host caches at repo root (if present)
.npm
**/.npm/_cacache
.pnpm-store

# Service temp + rendered output (large; never part of image build context)
OKVEVO/services/**/tmp/rendering/**
OKVEVO/services/**/tmp/processing/**
OKVEVO/services/**/output/**
!OKVEVO/services/**/tmp/**/.gitkeep
!OKVEVO/services/**/output/**/.gitkeep

# Logs
**/*.log
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*
**/pnpm-debug.log*
**/lerna-debug.log*

# macOS
**/.DS_Store
.DS_Store
**/.AppleDouble
**/.LSOverride
**/._*

# IDE
**/.vscode
**/.idea
**/.cursor
*.swp
*.swo
*~

# Git (entire trees — huge; not needed to compile HyperFrames inside Docker)
**/.git
.git

# Secrets (examples are allowed)
**/.env
**/.env.*
!**/.env.example

# Optional: other reference trees under N8N/references (keep hyperframes source only lean)
references/**/node_modules
references/**/.bun
references/**/dist
