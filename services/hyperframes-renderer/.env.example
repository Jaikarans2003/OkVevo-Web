# HyperFramesRenderer (services/hyperframes-renderer)

PORT=3030
NODE_ENV=development

# Where finished MP4s are stored (absolute in Docker: /output)
OUTPUT_DIR=./output

# Staging directory for each upload job
RENDER_TMP_DIR=./tmp/rendering

# Root of the HyperFrames monorepo (contains packages/cli). Default resolves to N8N/references/hyperframes.
# HYPERFRAMES_REPO=

# Optional explicit path to packages/cli/dist/cli.js
# HYPERFRAMES_CLI=

# Optional max upload size per file (bytes)
# MAX_UPLOAD_BYTES=536870912

# AWS (for ECS deploy scripts / task env)
# AWS_REGION=us-east-1
# AWS_ACCOUNT_ID=000000000000
# ECS_CLUSTER_NAME=okvevo-dev
# ECS_SERVICE_NAME=hyperframes-renderer
